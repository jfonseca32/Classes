WorldInfo {
  info [
    "CS 3630 Project 5: Sushi-Go-Round."
    "A revolving-sushi restaurant: the e-puck waiter (SUSHI-BOT) plans with RRT* and path smoothing,"
    "drives with a differential-drive pure-pursuit controller and reads the MNIST seat-number"
    "card on the back of each stool with a LeNet classifier."
    "World frame: x east, y north (meters), origin at the center of the dining room."
    "Generated by tools/build_restaurant.py from tools/restaurant_layout.py: edit the layout, not this file."
  ]
  title "CS 3630 Sushi-Go-Round"
  FPS 30
}
